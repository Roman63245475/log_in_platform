{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "gen-api": "bunx swagger-typescript-api generate -p http://localhost:5056/swagger/v1/swagger.json -o ./src/api -n API.ts"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "nswag": "^14.7.1"
  }
}
